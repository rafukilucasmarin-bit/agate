<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Agate Loader</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <options customize="never" require-scripts="false" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <choices-outline>
    <line choice="agate"/>
  </choices-outline>
  <choice id="agate" title="Agate Loader" visible="false">
    <pkg-ref id="io.github.agate.loader"/>
  </choice>
  <pkg-ref id="io.github.agate.loader" version="@VERSION@" onConclusion="none">agate-component.pkg</pkg-ref>
</installer-gui-script>
